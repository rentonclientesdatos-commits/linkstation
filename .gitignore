# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# onboarding bundles (contienen secretos — NUNCA commit)
onboarding-team-*.zip

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real .env, only .env.example (placeholders)
.env
.env.*
!.env.example
!.env.*.example

# secrets folder — credenciales de test, vault de cuentas, NUNCA a git
.secrets/
.secrets/**

# handoff bundles con secretos — NUNCA a git (zips de credenciales, briefings con secretos, scripts generadores)
docs/handoff/*-secretos-*.zip
docs/handoff/dashboard-af-secretos-*.zip
docs/handoff/briefing-equipo-dev-*.md
docs/handoff/generar-zip-secretos-equipo.ps1
# informes de seguridad de la clienta (pueden exponer superficie de ataque del VPS)
plans/reports/informe-clienta-seguridad-servidor-*.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent data
/brain/
/scratch/

# build outputs / runtime caches
/dist/
/.playwright-mcp/

# === Team scaffold — se versionan en `developer` (decisión 2026-05-20) ===
# .claude/, docs/, plans/, .claude-plugin/ SÍ van a git para compartir con el equipo de desarrollo.
# El repo local NO tiene remote al GitHub del cliente — eso garantiza que NO suba a renzo1111ia/dashboard-af.
#
# Sub-excepción: las docs originales de la cliente (PDFs/DOCX/PNG raw) NO se versionan.
# Los devs reciben la spec normalizada en docs/audit/00-client-spec-extraction.md (sí versionada).
docs/Docs-entrega-clienta/

# Bundle de auditoría generado (HTML+PDF+ZIP) — no se versiona, se regenera con docs/audit/_build/build_bundle.py
docs/auditoria/
docs/auditoria.zip

# Claude Code: settings.local.json contiene permisos/envs específicos del dev
# (incluyendo allowlist para SSH al VPS). settings.json sí se comparte.
.claude/settings.local.json

# Claude Code: logs de hooks (runtime, no aportan al repo) y agent-memory privado
.claude/logs/
.claude/agent-memory/
.claude/scheduled_tasks.lock

# Python bytecode cache
__pycache__/
*.pyc


# Backups locales de la DB (contienen datos seed + cualquier dato real cargado)
backups/local-db/

# Backups locales del RoadMap antes de operaciones masivas (script compactación, etc.)
plans/RoadMap.md.backup-*

# Salida temporal del gate npm audit del workflow security.yml (se regenera)
audit-prod.json
/scratch-*
/test-*
/*.sql
/templates.json
